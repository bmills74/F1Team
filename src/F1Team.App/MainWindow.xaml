<Window x:Class="F1Team.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:F1Team.App.ViewModels"
        mc:Ignorable="d"
        x:Name="Root"
        Title="F1 Fantasy Team Calculator"
        Height="860"
        Width="1500"
        MinHeight="720"
        MinWidth="1320"
        WindowStartupLocation="CenterScreen"
        Background="#f4f6f8"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}">
    <Window.Resources>
        <vm:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />
        <vm:FalseToVisibleConverter x:Key="FalseToVisible" />

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#d9dee7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#152033" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#617086" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#152033" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#c8d0dc" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                                <TextBlock x:Name="Watermark"
                                           Text="{TemplateBinding Tag}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#9aa5b5"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <Style x:Key="BudgetRemainingText" TargetType="TextBlock" BasedOn="{StaticResource MetricValue}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UserProjection.IsOverBudget}" Value="True">
                    <Setter Property="Foreground" Value="#c62828" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="SlotColumnHeader" TargetType="Control">
            <!-- Left inset of 11 matches each slot tile's Border (Padding 10 + BorderThickness 1)
                 so these headings line up with the data columns inside the tiles. -->
            <Grid Margin="11,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="66" />
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Asset" Foreground="#617086" />
                <TextBlock Grid.Column="2" Text="Cost" Foreground="#617086" />
                <TextBlock Grid.Column="3" Text="Pts" Foreground="#617086" />
                <TextBlock Grid.Column="4" Text="Value" Foreground="#617086" />
            </Grid>
        </ControlTemplate>

        <DataTemplate x:Key="SlotTileTemplate" DataType="{x:Type vm:AssetSlotViewModel}">
            <Grid Margin="0,0,0,8">
                <Button Command="{Binding DataContext.ActivateSlotCommand, ElementName=Root}"
                        CommandParameter="{Binding}"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent">
                    <Border x:Name="SlotBorder"
                            BorderBrush="#d9dee7"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Background="#fbfcfe">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="66" />
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" Foreground="#617086" />
                                <TextBlock x:Name="X2Badge"
                                           Text="x2"
                                           Visibility="Collapsed"
                                           Foreground="#315efb"
                                           FontWeight="SemiBold"
                                           FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="AssetNameText"
                                           Text="{Binding SelectedAsset.Name}"
                                           FontWeight="SemiBold"
                                           Foreground="#152033"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="EmptySlotText" Text="{Binding EmptyText}" Foreground="#8a96a8" FontStyle="Italic" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat={}{0:0.0}m, TargetNullValue=''}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding ExpectedPoints, StringFormat={}{0:0.0}, TargetNullValue=''}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding ExpectedBudgetChange, StringFormat={}{0:+0.0;-0.0;0.0}m, TargetNullValue=''}"
                                       Foreground="{Binding BudgetChangeColor}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Button>

                <Button Content="X"
                        Command="{Binding DataContext.ClearSlotCommand, ElementName=Root}"
                        CommandParameter="{Binding}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Width="26"
                        MinHeight="0"
                        Margin="0,1,1,9"
                        FontSize="11"
                        Padding="0"
                        Background="#eef2f7"
                        BorderBrush="#c8d0dc" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SelectedAsset}" Value="{x:Null}">
                    <Setter TargetName="SlotBorder" Property="BorderBrush" Value="#aeb8c7" />
                    <Setter TargetName="SlotBorder" Property="Background" Value="#f7f9fc" />
                    <Setter TargetName="AssetNameText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedAsset}" Value="{x:Null}">
                    <Setter TargetName="EmptySlotText" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="SlotBorder" Property="BorderBrush" Value="#315efb" />
                    <Setter TargetName="SlotBorder" Property="BorderThickness" Value="2" />
                    <Setter TargetName="SlotBorder" Property="Background" Value="#eef3ff" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsX2Driver}" Value="True">
                    <Setter TargetName="X2Badge" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="F1 Fantasy Team Calculator" FontSize="28" FontWeight="Bold" Foreground="#101828" />
                    <Border VerticalAlignment="Center"
                            Margin="14,6,0,0"
                            CornerRadius="10"
                            Padding="10,3"
                            Background="{Binding TeamStatusColor}">
                        <TextBlock Text="{Binding TeamStatusText}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding UpcomingRaceDetails}" Foreground="#152033" FontWeight="SemiBold" Margin="0,4,0,2" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RaceTitle}" Foreground="#617086" FontWeight="SemiBold" />
                    <TextBlock Text="  |  " Foreground="#9aa5b5" />
                    <TextBlock Text="{Binding SimulationTitle}" Foreground="#617086" />
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{Binding RefreshButtonText}"
                        Command="{Binding RefreshDataCommand}"
                        MinHeight="32"
                        Padding="14,0"
                        Margin="0,0,16,0" />
                <TextBlock Text="Expected points" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#617086" />
                <ComboBox ItemsSource="{Binding PointsSources}"
                          SelectedItem="{Binding SelectedPointsSource, Mode=TwoWay}"
                          MinWidth="126"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          ToolTip="Choose simulation points, the format-adjusted season average, or recent five-race form." />
                <CheckBox Content="Trim outliers"
                          IsChecked="{Binding TrimHistoricalOutliers, Mode=TwoWay}"
                          IsEnabled="{Binding CanTrimHistoricalOutliers}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          ToolTip="Remove one best and worst result for 5–10 races, or two of each for more than 10 races." />
                <TextBlock Text="{Binding PointsSourceTitle}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           Foreground="#617086" />
                <TextBlock Text="My actual budget" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#617086" />
                <TextBlock Text="{Binding UserProjection.CurrentBudget, StringFormat={}{0:0.0}m}"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#152033" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="0.72*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="My Team" Style="{StaticResource SectionTitle}" />
                        <Border Background="#f7f9fc" BorderBrush="#d9dee7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="x2 driver" Foreground="#617086" Margin="0,0,0,4"
                                           ToolTip="Your x2 (captain) driver scores double points. The extra points are added to the team's Expected Points total." />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Remaining budget" Foreground="#617086" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Actual budget" Foreground="#617086" Margin="12,0,0,4" />
                                <ComboBox Grid.Row="1" Grid.Column="0"
                                          ItemsSource="{Binding UserSelectedDrivers}"
                                          SelectedItem="{Binding MyX2Driver, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          MinHeight="30"
                                          VerticalContentAlignment="Center"
                                          ToolTip="Your x2 (captain) driver scores double points."
                                          Margin="0,0,10,0" />
                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock DockPanel.Dock="Right" Text="m" Foreground="#617086" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    <TextBox Text="{Binding MyRemainingBudgetText, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="30"
                                             VerticalContentAlignment="Center"
                                             HorizontalContentAlignment="Right"
                                             ToolTip="Enter your remaining budget and press Enter (or Set).">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SetMyBudgetCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </DockPanel>
                                <Button Grid.Row="1" Grid.Column="2" Content="Set" Command="{Binding SetMyBudgetCommand}" Style="{StaticResource CompactButton}" Margin="0" />
                                <TextBlock Grid.Row="1" Grid.Column="3"
                                           Text="{Binding UserProjection.CurrentBudget, StringFormat={}{0:0.0}m}"
                                           Foreground="#152033"
                                           FontWeight="SemiBold"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                        </Border>
                        <Control Template="{StaticResource SlotColumnHeader}" Focusable="False" HorizontalAlignment="Stretch" />
                        <ItemsControl ItemsSource="{Binding UserDriverSlots}" ItemTemplate="{StaticResource SlotTileTemplate}" />
                        <Separator Margin="0,4,0,12" />
                        <ItemsControl ItemsSource="{Binding UserConstructorSlots}" ItemTemplate="{StaticResource SlotTileTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Available Assets" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                        <Border CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,0,10"
                                Background="#eef3ff"
                                BorderBrush="#c9d8ff"
                                BorderThickness="1">
                            <TextBlock Text="{Binding ActivePickerTitle}"
                                       Foreground="#1c3fbf"
                                       FontWeight="SemiBold" />
                        </Border>
                        <TextBox x:Name="AssetSearchBox"
                                 Style="{StaticResource SearchBox}"
                                 Text="{Binding AssetSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10"
                                 Tag="Search by name or code..." />
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="Sort:" VerticalAlignment="Center" Foreground="#617086" Margin="0,0,8,6" />
                            <Button Content="Best points" Command="{Binding QuickSortCommand}" CommandParameter="ExpectedPoints" Padding="10,4" Margin="0,0,6,6" />
                            <Button Content="Best value" Command="{Binding QuickSortCommand}" CommandParameter="PointsPerMillion" Padding="10,4" Margin="0,0,6,6" />
                            <Button Content="Cheapest" Command="{Binding QuickSortCommand}" CommandParameter="Price" Padding="10,4" Margin="0,0,6,6" />
                            <Button Content="Budget gain" Command="{Binding QuickSortCommand}" CommandParameter="ExpectedBudgetChange" Padding="10,4" Margin="0,0,6,6" />
                            <Button Content="Name" Command="{Binding QuickSortCommand}" CommandParameter="Name" Padding="10,4" Margin="0,0,6,6" />
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              x:Name="AssetGrid"
                              ItemsSource="{Binding AssetPickerView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#f7f9fc">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <EventSetter Event="MouseLeftButtonUp" Handler="AssetRow_Click" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <StackPanel MaxWidth="320">
                                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="#152033" />
                                            <TextBlock Text="{Binding RecentFormLine}" Foreground="#152033" Margin="0,6,0,0"
                                                       Visibility="{Binding RecentFormLine, Converter={StaticResource EmptyToCollapsed}}" />
                                            <TextBlock Text="{Binding RequiredToRiseLine}" Foreground="#1b7f3a" Margin="0,4,0,0"
                                                       Visibility="{Binding RequiredToRiseLine, Converter={StaticResource EmptyToCollapsed}}" />
                                            <TextBlock Text="{Binding RequiredToFallLine}" Foreground="#b42318" Margin="0,2,0,0"
                                                       Visibility="{Binding RequiredToFallLine, Converter={StaticResource EmptyToCollapsed}}" />
                                            <TextBlock Text="{Binding PriceOddsLine}" Foreground="#617086" Margin="0,4,0,0"
                                                       Visibility="{Binding PriceOddsLine, Converter={StaticResource EmptyToCollapsed}}" />
                                            <TextBlock Text="{Binding VolatilityDetailLine}" Foreground="{Binding VolatilityColor}" Margin="0,4,0,0"
                                                       Visibility="{Binding VolatilityDetailLine, Converter={StaticResource EmptyToCollapsed}}" />
                                            <TextBlock Text="No detail data available." Foreground="#8a96a8" FontStyle="Italic"
                                                       Visibility="{Binding HasDetails, Converter={StaticResource FalseToVisible}}" />
                                            <TextBlock Text="Double-click to assign to the active slot." Foreground="#8a96a8" FontStyle="Italic" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAffordableForActiveSlot}" Value="False">
                                        <Setter Property="Background" Value="#fff1f0" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelectable}" Value="True" />
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#e2ebff" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" Width="*" MinWidth="96" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#152033" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SubtitleAbbreviation}"
                                                       Foreground="#8a96a8"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:0.0}m}" Width="56" SortMemberPath="Price" />
                            <DataGridTextColumn Header="Pts" Binding="{Binding ExpectedPoints, StringFormat={}{0:0.0}}" Width="48" SortMemberPath="ExpectedPoints" />
                            <DataGridTextColumn Header="Pts/$m" Binding="{Binding PointsPerMillion, StringFormat={}{0:0.00}}" Width="54" SortMemberPath="PointsPerMillion" />
                            <DataGridTextColumn Header="Risk" Binding="{Binding VolatilityText}" Width="58" SortMemberPath="VolatilityText">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding VolatilityColor}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Δ Price" Binding="{Binding ExpectedBudgetChange, StringFormat={}{0:+0.0;-0.0;0.0}m}" Width="62" SortMemberPath="ExpectedBudgetChange">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding BudgetChangeColor}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Picked" Binding="{Binding SelectedMarker}" Width="82" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                <TabControl SelectedIndex="{Binding SelectedComparisonTabIndex, Mode=TwoWay}">
                    <TabItem Header="Rival">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Name" Foreground="#617086" />
                                <TextBox Text="{Binding RivalName, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" Margin="0,4,0,12" />
                                <Border Background="#f7f9fc" BorderBrush="#d9dee7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="x2 driver" Foreground="#617086" Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Remaining budget" Foreground="#617086" Margin="0,0,0,4" />
                                        <ComboBox Grid.Row="1" Grid.Column="0"
                                                  ItemsSource="{Binding RivalSelectedDrivers}"
                                                  SelectedItem="{Binding RivalX2Driver, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  MinHeight="30"
                                                  VerticalContentAlignment="Center"
                                                  Margin="0,0,10,0" />
                                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock DockPanel.Dock="Right" Text="m" Foreground="#617086" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            <TextBox Text="{Binding RivalRemainingBudgetText, UpdateSourceTrigger=PropertyChanged}"
                                                     MinHeight="30"
                                                     VerticalContentAlignment="Center"
                                                     HorizontalContentAlignment="Right">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding SetRivalBudgetCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </DockPanel>
                                        <Button Grid.Row="1" Grid.Column="2" Content="Set" Command="{Binding SetRivalBudgetCommand}" Style="{StaticResource CompactButton}" Margin="0" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding RivalProjection.CurrentBudget, StringFormat=Actual budget: {0:0.0}m}"
                                           Foreground="#617086"
                                           Margin="0,0,0,12" />
                                <Control Template="{StaticResource SlotColumnHeader}" Focusable="False" HorizontalAlignment="Stretch" />
                                <ItemsControl ItemsSource="{Binding RivalDriverSlots}" ItemTemplate="{StaticResource SlotTileTemplate}" />
                                <Separator Margin="0,4,0,12" />
                                <ItemsControl ItemsSource="{Binding RivalConstructorSlots}" ItemTemplate="{StaticResource SlotTileTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Candidate">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,12,0,0">
                                <Button Content="Reset to My Team"
                                        Command="{Binding ResetCandidateCommand}"
                                        MinHeight="30"
                                        Padding="10,2"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12" />
                                <Border Background="#f7f9fc" BorderBrush="#d9dee7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="x2 driver" Foreground="#617086" Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Remaining budget" Foreground="#617086" Margin="0,0,0,4" />
                                        <ComboBox Grid.Row="1" Grid.Column="0"
                                                  ItemsSource="{Binding CandidateSelectedDrivers}"
                                                  SelectedItem="{Binding CandidateX2Driver, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  MinHeight="30"
                                                  VerticalContentAlignment="Center"
                                                  Margin="0,0,10,0" />
                                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock DockPanel.Dock="Right" Text="m" Foreground="#617086" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            <TextBox Text="{Binding CandidateRemainingBudgetText, UpdateSourceTrigger=PropertyChanged}"
                                                     MinHeight="30"
                                                     VerticalContentAlignment="Center"
                                                     HorizontalContentAlignment="Right">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Return" Command="{Binding SetCandidateBudgetCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                        </DockPanel>
                                        <Button Grid.Row="1" Grid.Column="2" Content="Set" Command="{Binding SetCandidateBudgetCommand}" Style="{StaticResource CompactButton}" Margin="0" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding CandidateProjection.CurrentBudget, StringFormat=Actual budget: {0:0.0}m}"
                                           Foreground="#617086"
                                           Margin="0,0,0,12" />
                                <Control Template="{StaticResource SlotColumnHeader}" Focusable="False" HorizontalAlignment="Stretch" />
                                <ItemsControl ItemsSource="{Binding CandidateDriverSlots}" ItemTemplate="{StaticResource SlotTileTemplate}" />
                                <Separator Margin="0,4,0,12" />
                                <ItemsControl ItemsSource="{Binding CandidateConstructorSlots}" ItemTemplate="{StaticResource SlotTileTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <TextBlock Text="Comparison" Style="{StaticResource SectionTitle}" />

                    <!-- Header row: team names -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="My" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#1c3fbf" />
                        <TextBlock Grid.Column="2" Text="{Binding RivalName}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#617086" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="Cand." HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="#617086" />
                    </Grid>
                    <Border Height="1" Background="#e2e7ef" Margin="0,0,0,4" />

                    <ItemsControl ItemsSource="{Binding ComparisonRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ComparisonRow}">
                                <Grid Margin="0,7,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#617086" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding MyText}" Foreground="{Binding MyColor}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding RivalText}" Foreground="{Binding RivalColor}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding CandidateText}" Foreground="{Binding CandidateColor}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="#e2e7ef" Margin="0,4,0,10" />
                    <TextBlock Text="My = your team. Higher points and less-negative remaining are better."
                               Foreground="#8a96a8"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#eaf0f8" BorderBrush="#d9dee7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0">
            <TextBlock Text="{Binding DataStatus}" Foreground="#46556b" />
        </Border>
    </Grid>
</Window>
